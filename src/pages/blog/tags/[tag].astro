---
import PageLayout from "../../../layouts/PageLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import { getPosts, slugifyTag, type Post } from "../../../utils/content";

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = new Map<string, { label: string; posts: Post[] }>();
  for (const p of posts) {
    for (const t of p.data.tags) {
      const slug = slugifyTag(t);
      const entry = tags.get(slug) ?? { label: t, posts: [] };
      entry.posts.push(p);
      tags.set(slug, entry);
    }
  }
  return [...tags].map(([tag, v]) => ({ params: { tag }, props: v }));
}

const { label, posts } = Astro.props as { label: string; posts: Post[] };
---

<PageLayout
  title={`Posts tagged “${label}”`}
  heading={`#${label}`}
  eyebrow="Blog · Tag"
  description={`Blog posts and notes tagged “${label}”.`}
>
  {posts.map((p) => <PostCard post={p} />)}
  <p><a href="/blog/">← All posts</a></p>
</PageLayout>
