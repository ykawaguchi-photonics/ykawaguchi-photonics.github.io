---
import PageLayout from "../../layouts/PageLayout.astro";
import JsonLd from "../../components/JsonLd.astro";
import { site } from "../../data/site";
import { getPublications, getResearchAreas } from "../../utils/content";
import { breadcrumbSchema } from "../../utils/schema";

const areas = await getResearchAreas();
const pubs = await getPublications();
const count = (id: string) => pubs.filter((p) => p.data.areas.some((a) => a.id === id)).length;
---

<PageLayout
  title="Research"
  heading="Research"
  eyebrow="Areas"
  description={`Research areas of ${site.name}: metasurfaces, flat optics, silicon photonics, topological photonics, nonreciprocal photonics, and optical sensing.`}
  lede="My work sits at the intersection of nanophotonic design, full-wave simulation, and experiment, from resonant metasurfaces and topological lattices to integrated photonic circuits."
>
  <JsonLd
    slot="head"
    data={breadcrumbSchema(Astro.site, [
      { name: "Home", path: "/" },
      { name: "Research", path: "/research/" },
    ])}
  />
  <ol class="areas">
    {
      areas.map((a, i) => (
        <li>
          <a class="area" href={`/research/${a.id}/`}>
            <span class="num" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <span class="text">
              <h2>{a.data.title}</h2>
              <p>{a.data.description}</p>
              <span class="count">
                {count(a.id)} publication{count(a.id) === 1 ? "" : "s"}
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>

  <section class="section tools">
    <div class="section-head"><h2>Methods &amp; tools</h2></div>
    <p class="muted">
      Full-wave electromagnetic simulation and computational design underpin all of the areas above.
    </p>
    <ul class="link-list">
      {site.tools.map((t) => <li><span class="chip">{t}</span></li>)}
    </ul>
  </section>
</PageLayout>

<style>
  .areas {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border);
  }
  .area {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-3);
    border-bottom: 1px solid var(--border);
    color: var(--text);
    text-decoration: none;
    transition: background var(--transition);
  }
  .area:hover {
    background: var(--surface);
    color: var(--text);
  }
  .area:hover h2 {
    color: var(--accent);
  }
  .num {
    font-family: var(--font-mono);
    color: var(--text-faint);
    font-size: var(--step--1);
    padding-top: 0.3rem;
  }
  h2 {
    font-size: var(--step-1);
    margin: 0 0 var(--space-2);
    transition: color var(--transition);
  }
  .text p {
    color: var(--text-muted);
    margin: 0 0 var(--space-2);
    max-width: var(--measure);
  }
  .count {
    font-size: var(--step--1);
    color: var(--text-faint);
  }
  .tools p {
    margin-bottom: var(--space-4);
  }
</style>
