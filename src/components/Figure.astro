---
// MDX usage:
//   import Figure from "@/components/Figure.astro";
//   import fig from "./my-figure.png";
//   <Figure src={fig} alt="What the image shows" caption="Caption text." number={1} />
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  number?: number;
  /** "wide" lets a figure extend beyond the text measure on large screens. */
  size?: "text" | "wide";
}
const { src, alt, caption, number, size = "text" } = Astro.props;
---

<figure class:list={["figure", size]}>
  <Image src={src} alt={alt} widths={[480, 800, 1200, 1600]} sizes="(max-width: 900px) 100vw, 900px" loading="lazy" />
  {
    (caption || number) && (
      <figcaption>
        {number && <strong>Figure {number}. </strong>}
        {caption}
        <slot />
      </figcaption>
    )
  }
</figure>

<style>
  .figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #fff;
  }
  @media (min-width: 1100px) {
    .figure.wide {
      width: min(900px, calc(100vw - 4rem));
    }
  }
</style>
