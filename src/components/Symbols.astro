---
// "Where…" box placed directly after a display equation, listing each symbol.
// Neutral surface (not the accent) so it never reads as a glossary box.
// MDX (blank line between the $$…$$ block and <Symbols>):
//   $$ \mathrm{FSR} = \frac{\lambda^2}{n_g L} $$
//
//   <Symbols>                (Japanese half: <Symbols title="記号">)
//   - $\lambda$ — vacuum wavelength (µm)
//   - $n_g$ — group index of the waveguide (—)
//   </Symbols>
// Children: a markdown bullet list, or a markdown table.
export interface Props {
  title?: string;
}
const { title = "Where" } = Astro.props;
---

<aside class="symbols" aria-label={title}>
  <p class="symbols-title" aria-hidden="true">{title}</p>
  <div class="symbols-body"><slot /></div>
</aside>

<style>
  .symbols {
    position: relative;
    /* pull up under the equation: prose blocks leave 1.25em below them */
    margin: -0.5em 0 1.75em;
    padding: var(--space-3) var(--space-5) var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-family: var(--font-sans);
    font-size: 0.875em;
    line-height: 1.6;
    color: var(--text);
  }
  /* thin connector from the equation down into the box */
  .symbols::before {
    content: "";
    position: absolute;
    left: calc(var(--space-5) + 0.2em);
    top: calc(-0.75em - 1px);
    height: 0.75em;
    border-left: 1px solid var(--border-strong);
  }
  .symbols-title {
    margin: 0 0 var(--space-2);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .symbols-body > :global(:first-child) {
    margin-top: 0;
  }
  .symbols-body > :global(:last-child) {
    margin-bottom: 0;
  }
  .symbols-body :global(p) {
    margin: 0 0 0.5em;
  }
  /* bullet list -> hanging-indent symbol list, no bullets */
  .symbols-body :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .symbols-body :global(ul > li) {
    padding-left: 1.25em;
    text-indent: -1.25em;
  }
  /* text-indent is inherited: reset it so KaTeX boxes and nested blocks are not shifted */
  .symbols-body :global(ul > li *) {
    text-indent: 0;
  }
  .symbols-body :global(li + li) {
    margin-top: 0.3em;
  }
  .symbols-body :global(li ul) {
    margin-top: 0.3em;
  }
  .symbols-body :global(ol) {
    margin: 0;
    padding-left: 1.4em;
  }
  .symbols-body :global(.katex) {
    font-size: 1.1em;
  }
  .symbols-body :global(.katex-display) {
    margin: 0.4em 0;
  }
  /* tables scroll horizontally inside the box on narrow screens */
  .symbols-body :global(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    margin: 0;
    font-size: 1em;
  }
  /* sticky first column (prose.css) needs the box's own opaque background */
  .symbols-body :global(:is(th, td):first-child) {
    background: var(--surface);
  }
  .symbols-body :global(th),
  .symbols-body :global(td) {
    padding: 0.35em 0.75em 0.35em 0;
    border-bottom: 1px solid var(--border);
  }
  .symbols-body :global(tr:last-child td) {
    border-bottom: 0;
  }
  @media (max-width: 480px) {
    .symbols-body :global(th),
    .symbols-body :global(td) {
      padding: 0.3em 0.5em 0.3em 0;
    }
  }
  .symbols-body :global(th) {
    font-size: 0.875em;
    font-weight: 600;
    color: var(--text-muted);
  }
  @media (max-width: 480px) {
    .symbols {
      padding: var(--space-3) var(--space-4);
    }
    .symbols::before {
      left: calc(var(--space-4) + 0.2em);
    }
  }
  @media print {
    .symbols {
      background: none;
      border-color: currentColor;
      break-inside: avoid;
    }
  }
</style>
