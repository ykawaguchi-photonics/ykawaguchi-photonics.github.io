---
import { getCategory } from "../data/categories";
import { formatDate, isoDate, type Post } from "../utils/content";

export interface Props {
  post: Post;
  headingLevel?: "h2" | "h3";
}
const { post, headingLevel: H = "h2" } = Astro.props;
const d = post.data;
const cat = getCategory(d.category);
---

<article class="post-card">
  <p class="meta">
    <a class="cat" href={`/blog/category/${d.category}/`}>{cat?.label}</a>
    <span aria-hidden="true">·</span>
    <time datetime={isoDate(d.date)}>{formatDate(d.date, "short")}</time>
    {d.draft && <span class="draft">Draft</span>}
  </p>
  <H class="title"><a href={`/blog/${post.id}/`}>{d.title}</a></H>
  <p class="desc">{d.description}</p>
</article>

<style>
  .post-card {
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--border);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    font-size: var(--step--1);
    color: var(--text-muted);
    margin: 0 0 var(--space-2);
  }
  .cat {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }
  .cat:hover {
    text-decoration: underline;
  }
  .draft {
    color: var(--bg);
    background: var(--text-muted);
    border-radius: 3px;
    padding: 0 0.4em;
    font-weight: 600;
  }
  .title {
    font-size: var(--step-1);
    margin: 0 0 var(--space-2);
  }
  .title a {
    color: var(--text);
    text-decoration: none;
  }
  .title a:hover {
    color: var(--accent);
  }
  .desc {
    color: var(--text-muted);
    margin: 0;
    max-width: var(--measure);
  }
</style>
